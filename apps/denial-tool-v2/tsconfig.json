{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "ignoreDeprecations": "6.0",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@tensaw/actions": ["./stubs/tensaw/actions.ts"],
      "react-router-dom": ["./stubs/react-router-dom.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "stubs/**/*.ts", "stubs/**/*.tsx", "scripts/**/*.ts", "scripts/**/*.tsx"]
}
